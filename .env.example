# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_URI_TEST=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_URI=

# ── Seed ──────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_NOMBRE=
SEED_USER2_EMAIL=programador6@tubosyconexiones.mx
SEED_USER2_NOMBRE=daniel6
SEED_USER2_ROLE=admin

SEED_USER3_EMAIL=
SEED_USER3_NOMBRE=
SEED_USER3_ROLE=

# ── Auth0 ─────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── SAT Web Services ──────────────────────────────────────────────────────────
SAT_ENDPOINT=
SAT_VERIFICA_CFDI_WSDL=
SAT_DESCARGA_MASIVA_AUTENTICACION=
SAT_DESCARGA_MASIVA_SOLICITUD=
SAT_DESCARGA_MASIVA_VERIFICA=
SAT_DESCARGA_MASIVA_DESCARGA=

# ── Credenciales / e.firma ────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDS_MASTER_KEY=

# ── FIEL (requerida para Descarga Masiva) ─────────────────────────────────────
FIEL_CER_PATH=./certs/fiel.cer
FIEL_KEY_PATH=./certs/fiel.key
FIEL_KEY_PASSWORD=

# ── RFC ───────────────────────────────────────────────────────────────────────
COMPANY_RFC=
RFCS_ACTIVOS=

# ── ERP Integration ───────────────────────────────────────────────────────────
# ERP_CAJA_BASE_URL: URL base de Kore Cajas. Usado para /cuentas-pendientes con ERP_TOKEN.
ERP_CAJA_BASE_URL=
# ERP_TOKEN: token de servicio (JWT estático) para endpoints ERP que no requieren sesión de usuario.
ERP_TOKEN=
# ERP_API_BASE_URL / ERP_API_TOKEN: usados por el módulo Visor para carga y enriquecimiento de facturas.
ERP_API_BASE_URL=
ERP_API_TOKEN=

# ── Kore Cajas / Cobros ───────────────────────────────────────────────────────
# KORE_AUTH_URL apunta a PRODUCCIÓN (autenticación real). El resto debe apuntar a test.
KORE_AUTH_URL=
KORE_SERVICIO=
KORE_CAJA_URL=
KORE_CAJA_BASE_URL=
KORE_FORMASPAGO_BASE_URL=

# ── Google / Cloud ────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ERP_FOLDER_ID=
GOOGLE_DRIVE_COMPROBANTES_FOLDER_ID=

# ── OCR / Análisis de comprobantes ────────────────────────────────────────────
# Opciones: 'tesseract' (local, gratis) | 'claude' (API, mayor precisión)
RECEIPT_OCR_ENGINE=tesseract
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=
GEMINI_API_KEY=

# ── Solicitudes de Cobro ERP-Kore ──────────────────────────────────────────────
# API key compartida con el ERP (Kore) para POST /api/collection-requests —
# esa llamada es servidor a servidor, sin sesión Numo/Auth0. El ERP debe enviarla
# en el header X-Api-Key.
COLLECTION_REQUESTS_API_KEY=

# ── Test Auth (SOLO desarrollo) ─────────────────────────────────────────────────
# Si esta variable existe Y NODE_ENV != production, se habilita
# POST /api/dev/test-token para emitir tokens de prueba (HS256) sin pasar por
# Auth0. Déjala vacía (o sin definir) para desactivar el atajo por completo —
# nunca debe tener valor en el .env de producción.
TEST_AUTH_SECRET=

# ── Rate Limiting / CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ── Cron — Descarga Masiva SAT ────────────────────────────────────────────────
# Formato cron. Por defecto: 1:00 AM hora de México
CRON_HORA=0 1 * * *

# ── Correo (SMTP) — alertas de vencimiento de credenciales SAT ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Numo <no-reply@tuempresa.com>"

# Horas antes del vencimiento para el aviso "última llamada" (además de 2 días
# y 1 día antes, que son fijos). Por defecto: 4 horas.
SAT_CREDENCIALES_ALERTA_HORAS_ANTES=4
